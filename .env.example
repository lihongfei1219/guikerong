# 复制为 .env 并填写实际值；用 uv run --env-file .env 加载，应用不自动读取文件。
GUIKERONG_ENV=development
GUIKERONG_MATCHING_MODE=deepseek
# 聊天会话、知识及复核记录的本地持久化位置；含企业资料，请按业务数据管理。
# GUIKERONG_HARNESS_DB=data/harness.sqlite3
# GUIKERONG_CSV_PATH=科技金融产品.csv

# DeepSeek 官方 Flash：填写独立密钥；未配置仍可启动页面和查看产品库。
# DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_CONCURRENCY=8
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_MAX_PROMPT_CHARACTERS=200000
DEEPSEEK_MAX_PRODUCTS=100
DEEPSEEK_THINKING=disabled

# 火山引擎方舟兼容模式：将 GUIKERONG_MATCHING_MODE 改为 ark，再配置以下参数。
# deepseek 模式不会读取下列 ARK_* 或 LLM_DEEPSEEK_FLASH* 别名。
# ARK_API_KEY=replace-with-your-ark-api-key
# ARK_MODEL=replace-with-console-model-or-endpoint-id
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 也支持以下命名；同一字段的 ARK_* 如果已设置则优先（包括空值）。
# LLM_DEEPSEEK_FLASH_API_KEY=replace-with-your-ark-api-key
# LLM_DEEPSEEK_FLASH_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_DEEPSEEK_FLASH=replace-with-console-model-or-endpoint-id
# ARK_TIMEOUT_SECONDS=60
# ARK_MAX_RETRIES=1
# ARK_CONCURRENCY=8
# ARK_MAX_COMPLETION_TOKENS=4096
# ARK_MAX_PROMPT_CHARACTERS=200000
# ARK_MAX_PRODUCTS=100
# ARK_THINKING=disabled
# 整次匹配默认300秒；可显式覆盖。每产品一个独立协程，并发HTTP数受上述配置限制。
# GUIKERONG_MATCH_TIMEOUT_SECONDS=300
# 产品目录运行时从 SQLite 读取；CSV 仅用于显式导入。
# GUIKERONG_CATALOG_DB=data/products.sqlite3
